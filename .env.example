# Every variable has a working default, so the service starts with no .env at
# all. Copy this file only to override something.
PORT=4000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=activity_weather
# How often the background refresher wakes, in milliseconds. 0 turns it off,
# which is what a second instance behind the same database should run with —
# because one refresher covers the whole database, not because a second would
# be unsafe. The lease makes a second correct; it does not make it useful.
REFRESH_INTERVAL_MS=600000
